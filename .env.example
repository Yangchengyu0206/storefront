# Replace URL with your Saleor backend. Make sure to keep the slash at the end.
NEXT_PUBLIC_SALEOR_API_URL=https://storefront1.saleor.cloud/graphql/

# storefront 自己的對外網址。canonical / OG 用它，**寄給客人的驗證信與重設密碼信裡的
# 連結也用它**——所以正式環境缺了不是 SEO 打折，是客人收到點不開的信。
# production build 時若未設定或指向 localhost，build 會直接失敗（見 src/lib/env.ts）。
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Set the default Saleor channel slug for the storefront.
# Used to redirect "/" to the specified channel path (e.g., "/en-gb", "/en-eu", "/fr-ca", "/it-eu").
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Token used for fetching channels
SALEOR_APP_TOKEN=

# 網路銷售營業人新制(台財稅 2023):官網須揭露營業人名稱與統一編號。
# 設定後顯示在頁尾;留空則不顯示該區塊。NEXT_PUBLIC_SELLER_CONTACT 選填(email 或電話)。
# NEXT_PUBLIC_SELLER_NAME 同時作為全站店名來源(Logo/結帳抬頭/各頁 <title>/頁尾版權);
# 未設定時退回中性字樣「商店」,避免露出 demo 品牌。上線務必填入正式店名。
NEXT_PUBLIC_SELLER_NAME=ananaofficial
NEXT_PUBLIC_SELLER_TAX_ID=
NEXT_PUBLIC_SELLER_CONTACT=

# 法務頁(隱私權/服務條款/退換貨)對外揭露之營運者資訊 —— 消保法、個資法均要求可供查詢。
# 統編/稅籍核發後填入即自動套用到三個法務頁,無須改碼;未填則頁面顯示 [請填寫] 占位字樣。
# NAME/TAX_ID 與上方共用(法務頁優先讀同名變數)。
NEXT_PUBLIC_SELLER_ADDRESS=
NEXT_PUBLIC_SELLER_OPERATOR=
NEXT_PUBLIC_SELLER_EMAIL=
NEXT_PUBLIC_SELLER_PHONE=
# 選填:覆寫預設值。未填則用內建預設(服務時間週一至五 10:00–18:00、管轄法院臺灣臺北地方法院)。
NEXT_PUBLIC_SELLER_SERVICE_HOURS=
NEXT_PUBLIC_SELLER_COURT=

# 後端 API base URL(自家 FastAPI ops-core,非 Saleor GraphQL)。
# 綠界物流門市選擇(CvsStoreSelector)與綠界付款轉跳(ecpayComponent)會呼叫此位址;
# 開發時未設定會退回 http://localhost:8002;**production build 未設定或指向 localhost
# 會直接 build 失敗**(見 src/lib/env.ts)。這是刻意的——這個值會送到客人的瀏覽器,
# 指向 localhost 等於叫客人連他自己的電腦,現象是「選店打不開/按付款沒反應」且無錯誤訊息。
NEXT_PUBLIC_API_URL=

# 僅供本機做 production build 煙霧測試時暫時關閉上述防呆。正式部署不要設。
NEXT_PUBLIC_ALLOW_LOCAL_URLS=

# ── 社群登入(Google / LINE)──────────────────────────────────
# 選用功能;啟用前請一併設好以下所有變數,否則登入會失敗。
# 前端顯示社群登入按鈕的開關(字串 "true" 才會開啟)。
NEXT_PUBLIC_SOCIAL_LOGIN_ENABLED=
# Auth.js(NextAuth v5)session 加密金鑰:openssl rand -base64 32
AUTH_SECRET=
# Google Cloud OAuth client 憑證
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# LINE Login channel 憑證(須與 Messaging API 同一 provider)
#   ⚠ 必須和「客人用的官方帳號」在同一個 provider：LINE userId 是每個 provider 一組，
#     不同 provider 拿到的 userId 推播不到人，綁定等於白做。
#   ⚠ LINE Login channel 設定裡要把「Linked OA」指向客人用的官方帳號，
#     登入／綁定畫面才會出現「加入好友」（auth.ts 的 bot_prompt=aggressive）。
#   設了 AUTH_LINE_ID（且下面的 API_CORE_* 有設）「我的帳戶」才會出現「綁定 LINE」。
AUTH_LINE_ID=
AUTH_LINE_SECRET=
# 註：社群登入新帳號的確認、LINE 綁定都經 api-core 代做（API_CORE_URL /
# API_CORE_INTERNAL_SECRET，見下方訪客訂單查詢段），storefront 不需要全權 SALEOR_APP_TOKEN。
# 前端 /api/auth/bridge 換取 Saleor 登入時的共享密鑰(見 lib/saleor-social-bridge.ts),
# 須與後端 bridge 端點設定的值一致。
SALEOR_SOCIAL_BRIDGE_SECRET=

# ERP / 後端 webhook 呼叫 src/app/api/erp/* 路由時的驗證密鑰(X-ERP-Secret header,
# 見 src/app/ARCHITECTURE.md)。目前無啟用中的 ERP 路由,新增該類路由時須設定。
ERP_WEBHOOK_SECRET=

# 註:Stripe 公開金鑰(publishable key)由後端 payment gateway config 下發
# (config.data.stripePublishableKey),非透過前端環境變數提供,故此處不列 NEXT_PUBLIC_STRIPE_PK。

# ── 訪客訂單查詢（SF-08 / C-24）────────────────────────────────────────────────
# /orders/lookup 讓訪客用「訂單編號 + Email」查訂單。查詢由 **伺服器端** 呼叫 api-core
# 代查（api-core 已持有 Saleor 權限），所以不需要把全權的 SALEOR_APP_TOKEN 放進 storefront。
# 兩個值都必須與 full-stack/.env 對得上：
#   API_CORE_URL            → api-core 的位址（Docker 內部用 http://api-core:8000）
#   API_CORE_INTERNAL_SECRET → 與 full-stack/.env 的 LOGISTICS_INTERNAL_API_SECRET 相同
# 沒設的話這個頁面會明確報「訂單查詢尚未設定完成」，不會靜默失敗。
API_CORE_URL=
API_CORE_INTERNAL_SECRET=

# ── 錯誤監控（SF-07）────────────────────────────────────────────────────────────
# 三個後端服務都已接 Sentry，storefront 原本沒有——也就是唯一客人會看到的錯誤，
# 我們是唯一看不到的。填入 DSN 即啟用（只在 production build 生效）。
# 用 NEXT_PUBLIC_ 前綴是因為瀏覽器端要用；DSN 設計上就是可公開的（只能上報不能讀取）。
# 可以與後端三服務填同一個 Sentry 專案的 DSN。
NEXT_PUBLIC_SENTRY_DSN=

# ── 運費揭露（SF-12）────────────────────────────────────────────────────────────
# 購物車的運費與滿額免運文案由 api-core 提供（真相源是後台的 shop_setting），
# 沿用上方訪客訂單查詢的 API_CORE_URL / API_CORE_INTERNAL_SECRET，不需要額外變數。
